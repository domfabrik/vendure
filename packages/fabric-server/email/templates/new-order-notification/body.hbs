<mjml>
    <mj-head>
        <mj-title>Новый заказ {{ order.code }}</mj-title>
        <mj-preview>Новый заказ {{ order.code }} на сумму {{ display.totals.totalWithTax }}</mj-preview>
        <mj-style inline="inline">
            .section-title div {
                font-size: 18px;
                font-weight: 700;
            }
            .meta-label {
                color: #6b7280;
            }
            .card {
                background-color: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
            }
            .table th {
                text-align: left;
                padding: 8px;
                background-color: #eef2f7;
            }
            .table td {
                padding: 8px;
                border-bottom: 1px solid #e5e7eb;
                vertical-align: top;
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#f3f4f6">
        <mj-section background-color="#111827" padding="24px">
            <mj-column>
                <mj-text color="#ffffff" font-size="24px" font-weight="700">
                    Новый заказ {{ order.code }}
                </mj-text>
                <mj-text color="#d1d5db" font-size="14px">
                    Создан {{ display.createdAt }}
                </mj-text>
            </mj-column>
            <mj-column>
                <mj-text align="right" color="#ffffff" font-size="14px">
                    <span class="meta-label">Статус:</span> {{ order.state }}<br />
                    <span class="meta-label">Итого:</span> {{ display.totals.totalWithTax }}<br />
                    <span class="meta-label">Позиций:</span> {{ order.totalQuantity }}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="16px 0 0">
            <mj-column css-class="card" padding="20px">
                <mj-text css-class="section-title">Контакты</mj-text>
                <mj-text>
                    <strong>Покупатель:</strong>
                    {{#if order.customer}}
                        {{order.customer.firstName}} {{order.customer.lastName}}
                    {{else}}
                        Не привязан
                    {{/if}}
                    <br />
                    <strong>Email:</strong>
                    {{#if order.customer}}{{order.customer.emailAddress}}{{else}}-{{/if}}
                    <br />
                    <strong>Телефон:</strong>
                    {{#if order.customer.phoneNumber}}{{order.customer.phoneNumber}}{{else}}-{{/if}}
                    <br />
                    <strong>Получатель:</strong>
                    {{#if order.customFields.recipientFullName}}{{order.customFields.recipientFullName}}{{else}}-{{/if}}
                    <br />
                    <strong>Телефон получателя:</strong>
                    {{#if order.customFields.recipientPhoneNumber}}{{order.customFields.recipientPhoneNumber}}{{else}}-{{/if}}
                    <br />
                    <strong>Купоны:</strong>
                    {{#if order.couponCodes.length}}
                        {{#each order.couponCodes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                    {{else}}
                        -
                    {{/if}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column width="50%" css-class="card" padding="20px">
                <mj-text css-class="section-title">Адрес доставки</mj-text>
                <mj-text>
                    {{#with order.shippingAddress}}
                        {{#if fullName}}<strong>{{ fullName }}</strong><br />{{/if}}
                        {{#if company}}{{ company }}<br />{{/if}}
                        {{#if streetLine1}}{{ streetLine1 }}<br />{{/if}}
                        {{#if streetLine2}}{{ streetLine2 }}<br />{{/if}}
                        {{#if city}}{{ city }}<br />{{/if}}
                        {{#if province}}{{ province }}<br />{{/if}}
                        {{#if postalCode}}{{ postalCode }}<br />{{/if}}
                        {{#if country}}{{ country }}<br />{{/if}}
                        {{#if phoneNumber}}{{ phoneNumber }}{{/if}}
                    {{/with}}
                </mj-text>
            </mj-column>
            <mj-column width="50%" css-class="card" padding="20px">
                <mj-text css-class="section-title">Платёжный адрес</mj-text>
                <mj-text>
                    {{#with order.billingAddress}}
                        {{#if fullName}}<strong>{{ fullName }}</strong><br />{{/if}}
                        {{#if company}}{{ company }}<br />{{/if}}
                        {{#if streetLine1}}{{ streetLine1 }}<br />{{/if}}
                        {{#if streetLine2}}{{ streetLine2 }}<br />{{/if}}
                        {{#if city}}{{ city }}<br />{{/if}}
                        {{#if province}}{{ province }}<br />{{/if}}
                        {{#if postalCode}}{{ postalCode }}<br />{{/if}}
                        {{#if country}}{{ country }}<br />{{/if}}
                        {{#if phoneNumber}}{{ phoneNumber }}{{/if}}
                    {{/with}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column css-class="card" padding="20px">
                <mj-text css-class="section-title">Состав заказа</mj-text>
                <mj-table css-class="table">
                    <tr>
                        <th>SKU</th>
                        <th>Товар</th>
                        <th>Кол-во</th>
                        <th>Цена</th>
                        <th>Сумма</th>
                    </tr>
                    {{#each display.lines}}
                        <tr>
                            <td>{{ sku }}</td>
                            <td>
                                {{ productVariantName }}
                                {{#if productName}}
                                    <br />
                                    <span style="color:#6b7280;">{{ productName }}</span>
                                {{/if}}
                            </td>
                            <td>{{ quantity }}</td>
                            <td>{{ discountedUnitPriceWithTax }}</td>
                            <td>{{ discountedLinePriceWithTax }}</td>
                        </tr>
                    {{/each}}
                    <tr>
                        <td colspan="4"><strong>Подытог</strong></td>
                        <td><strong>{{ display.totals.subTotalWithTax }}</strong></td>
                    </tr>
                    {{#each display.shippingLines}}
                        <tr>
                            <td colspan="4">Доставка{{#if name}} ({{ name }}){{/if}}</td>
                            <td>{{ priceWithTax }}</td>
                        </tr>
                    {{/each}}
                    {{#each display.surcharges}}
                        <tr>
                            <td colspan="4">Наценка: {{ description }}</td>
                            <td>{{ priceWithTax }}</td>
                        </tr>
                    {{/each}}
                    {{#each display.discounts}}
                        <tr>
                            <td colspan="4">Скидка: {{ description }}</td>
                            <td>{{ amountWithTax }}</td>
                        </tr>
                    {{/each}}
                    <tr>
                        <td colspan="4"><strong>Итого</strong></td>
                        <td><strong>{{ display.totals.totalWithTax }}</strong></td>
                    </tr>
                </mj-table>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column css-class="card" padding="20px">
                <mj-text css-class="section-title">Платежи</mj-text>
                <mj-table css-class="table">
                    <tr>
                        <th>Метод</th>
                        <th>Статус</th>
                        <th>Сумма</th>
                        <th>Transaction ID</th>
                    </tr>
                    {{#each display.payments}}
                        <tr>
                            <td>{{ method }}</td>
                            <td>{{ state }}</td>
                            <td>{{ amount }}</td>
                            <td>{{#if transactionId}}{{ transactionId }}{{else}}-{{/if}}</td>
                        </tr>
                    {{/each}}
                </mj-table>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
