<mjml>
    <mj-head>
        <mj-title>Новый заказ {{order.code}}</mj-title>
        <mj-preview>Новый заказ {{order.code}} на сумму {{display.totals.totalWithTax}}</mj-preview>
        <mj-style inline='inline'>
            .section-title div { font-size: 18px; font-weight: 700; } .meta-label { color: #6b7280; } .card {
            background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; } .order-line {
            border-bottom: 1px solid #e5e7eb; padding-bottom: 16px; margin-bottom: 16px; } .order-line-title {
            font-size: 16px; font-weight: 700; } .order-line-meta { color: #4b5563; margin-top: 6px; }
            .order-line-quantity { margin-top: 6px; } .order-line-price { margin-top: 6px; font-weight: 700; }
            .order-total { margin-top: 8px; } .header-summary { font-size: 16px; line-height: 1.5;
            font-weight: 700; } .header-technical { font-size: 11px; line-height: 1.35; } .order-code {
            overflow-wrap: anywhere; word-break: break-all; font-size: 11px; }
        </mj-style>
    </mj-head>
    <mj-body background-color='#f3f4f6'>
        <mj-section background-color='#111827' padding='24px'>
            <mj-column width='65%'>
                <mj-text color='#ffffff' font-size='24px' font-weight='700'>
                    Новый заказ
                </mj-text>
                <mj-text
                    css-class='header-summary'
                    color='#ffffff'
                    font-size='16px'
                    font-weight='700'
                    padding-top='0'
                >
                    <strong>Создан:</strong>
                    {{display.createdAt}}<br />
                    <strong>Итого:</strong>
                    {{display.totals.totalWithTax}}<br />
                    <strong>Позиций:</strong>
                    {{order.totalQuantity}}
                </mj-text>
            </mj-column>
            <mj-column width='35%'>
                <mj-text
                    css-class='header-technical'
                    align='right'
                    color='#d1d5db'
                    font-size='11px'
                    padding-top='8px'
                >
                    <span class='meta-label'>Номер заказа:</span><br />
                    <span class='order-code'>{{order.code}}</span><br />
                    <span class='meta-label'>Статус:</span><br />
                    <span>{{order.state}}</span>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding='16px 0 0'>
            <mj-column css-class='card' padding='20px'>
                <mj-text css-class='section-title'>Контакты</mj-text>
                <mj-text>
                    <strong>Покупатель:</strong>
                    {{#if order.customer}}
                        {{order.customer.firstName}}
                        {{order.customer.lastName}}
                    {{else}}
                        Не привязан
                    {{/if}}
                    <br />
                    <strong>Email:</strong>
                    {{#if order.customer}}{{order.customer.emailAddress}}{{else}}-{{/if}}
                    <br />
                    <strong>Телефон:</strong>
                    {{#if order.customer.phoneNumber}}{{order.customer.phoneNumber}}{{else}}-{{/if}}
                    <br />
                    <strong>Получатель:</strong>
                    {{#if
                        order.customFields.recipientFullName
                    }}{{order.customFields.recipientFullName}}{{else}}-{{/if}}
                    <br />
                    <strong>Телефон получателя:</strong>
                    {{#if
                        order.customFields.recipientPhoneNumber
                    }}{{order.customFields.recipientPhoneNumber}}{{else}}-{{/if}}
                    <br />
                    <strong>Купоны:</strong>
                    {{#if order.couponCodes.length}}
                        {{#each order.couponCodes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                    {{else}}
                        -
                    {{/if}}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column css-class='card' padding='20px'>
                <mj-text css-class='section-title'>Состав заказа</mj-text>
                {{#each display.lines}}
                    <mj-text css-class='order-line'>
                        <div class='order-line-title'>Позиция
                            {{position}}
                            ·
                            {{#if productUrl}}
                                <a
                                    href='{{productUrl}}'
                                    style='color:#2563eb;text-decoration:underline;'
                                >{{productName}}</a>
                            {{else}}
                                {{productName}}
                            {{/if}}
                        </div>
                        <div class='order-line-meta'>
                            Вариант:
                            {{productVariantName}}
                        </div>
                        <div class='order-line-quantity'>Количество: {{quantity}} шт.</div>
                        <div class='order-line-price'>Цена в магазине: {{discountedUnitPriceWithTax}}</div>
                    </mj-text>
                {{/each}}
                {{#each display.shippingLines}}
                    <mj-text css-class='order-total'>Доставка{{#if name}} ({{name}}){{/if}}:
                        {{priceWithTax}}</mj-text>
                {{/each}}
                {{#each display.surcharges}}
                    <mj-text css-class='order-total'>Наценка: {{description}} — {{priceWithTax}}</mj-text>
                {{/each}}
                {{#each display.discounts}}
                    <mj-text css-class='order-total'>Скидка: {{description}} — {{amountWithTax}}</mj-text>
                {{/each}}
                <mj-text css-class='order-total'><strong>Итого:</strong>
                    {{display.totals.totalWithTax}}</mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column css-class='card' padding='20px'>
                <mj-text css-class='section-title'>Платежи</mj-text>
                <mj-table css-class='table'>
                    <tr>
                        <th>Метод</th>
                        <th>Статус</th>
                        <th>Сумма</th>
                        <th>Transaction ID</th>
                    </tr>
                    {{#each display.payments}}
                        <tr>
                            <td>{{method}}</td>
                            <td>{{state}}</td>
                            <td>{{amount}}</td>
                            <td>{{#if transactionId}}{{transactionId}}{{else}}-{{/if}}</td>
                        </tr>
                    {{/each}}
                </mj-table>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>